
#include <stdio.h>

typedef struct {
    char nome[50];
    float media;
} Aluno;

int main() {
    Aluno alunos[10];
    int i, maior = 0, menor = 0, acima = 0, aprovados = 0;
    float soma = 0, mediaGeral;

    // Cadastro
    for (i = 0; i < 10; i++) {
        printf("\nAluno %d\n", i + 1);
        printf("Nome: ");
        scanf(" %[^\n]", alunos[i].nome);
        printf("Media: ");
        scanf("%f", &alunos[i].media);

        soma += alunos[i].media;
    }

    mediaGeral = soma / 10;

    // Maior e menor media
    for (i = 1; i < 10; i++) {
        if (alunos[i].media > alunos[maior].media)
            maior = i;

        if (alunos[i].media < alunos[menor].media)
            menor = i;
    }

    // Acima da media e aprovados
    for (i = 0; i < 10; i++) {
        if (alunos[i].media > mediaGeral)
            acima++;

        if (alunos[i].media >= 60)
            aprovados++;
    }

    // Resultados
    printf("\n--- ALUNOS ---\n");
    for (i = 0; i < 10; i++)
        printf("%s - %.2f\n", alunos[i].nome, alunos[i].media);

    printf("\nMaior media: %s (%.2f)\n",
           alunos[maior].nome, alunos[maior].media);

    printf("Menor media: %s (%.2f)\n",
           alunos[menor].nome, alunos[menor].media);

    printf("Media geral: %.2f\n", mediaGeral);
    printf("Acima da media geral: %d\n", acima);
    printf("Aprovados: %d\n", aprovados);

    return 0;
}

